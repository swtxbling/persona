{
  "name": "notify_user",
  "description": "Push the user now, even when the app is closed; tapping opens this conversation. Use for scheduled results and time-sensitive news. With QuietPush on, ordinary, background and non-main notices are P1 (Needs you and briefing, no alert). P0 requires push_level P0, an interrupting why_owner and the owner's foreground main-conversation turn. Held means not alerted. QuietPush off keeps existing behavior.",
  "input_schema": {
    "type": "object",
    "required": [
      "title",
      "body"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "push_level": {
        "type": "string",
        "enum": [
          "P0",
          "P1"
        ],
        "description": "P1: Needs you and briefing, no alert with QuietPush. P0 needs an interrupting why_owner and the owner's foreground main turn; use P1 for results"
      },
      "why_owner": {
        "type": "string",
        "enum": [
          "irreversible",
          "visible_to_others",
          "priority",
          "acceptance",
          "only_owner_knows"
        ],
        "description": "With P0, why only the user can act. priority stays P1; other reasons are P0-eligible only in the owner's foreground main-conversation turn. Omit for ordinary notices"
      },
      "related_key": {
        "type": "string",
        "description": "Optional: what this is about, such as a PR link or a to-do id. In push grading the same key interrupts at most once in 12 hours, and held notices about it are listed together."
      }
    }
  }
}
